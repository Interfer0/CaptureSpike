<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CaptureSpike.App.App">
  <Application.Styles>
    <FluentTheme>
      <!-- Custom palette: teal accent in both variants.
           RegionColor shifts the FluentTheme surface palette so dark/light
           accents don't fight each other on system surfaces. Note: only
           Accent supports runtime changes; the rest are read once. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light"
                               Accent="#0E8A93"
                               RegionColor="#FAFAFA" />
        <ColorPaletteResources x:Key="Dark"
                               Accent="#3FB6BF"
                               RegionColor="#1F1F23" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Base font size bump: the UI was set too small to read comfortably.
         Explicit per-control sizes in the windows scale up from here. -->
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="15" />
    </Style>
  </Application.Styles>

  <!-- Theme-aware brushes. Referenced from XAML via DynamicResource so
       they flip instantly when RequestedThemeVariant changes at runtime
       (the Settings → Theme picker). The keys are mirrored as constants
       in ThemeKeys.cs so the C# tile code in TiledPlaybackWindow can
       resolve the same brushes. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#3A3F44" />
          <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#F2F4F7" />
          <SolidColorBrush x:Key="DividerBrush"           Color="#3A3A3A" />
          <SolidColorBrush x:Key="MutedTileBrush"          Color="#1A1A1A" />
          <SolidColorBrush x:Key="MutedTileMutedBrush"     Color="#3C0D0D" />
          <SolidColorBrush x:Key="TileBorderBrush"         Color="#555555" />
          <SolidColorBrush x:Key="TileBorderMutedBrush"    Color="#C84040" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E4E7EB" />
          <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#1A1F23" />
          <SolidColorBrush x:Key="DividerBrush"           Color="#D5DBE3" />
          <SolidColorBrush x:Key="MutedTileBrush"          Color="#FFFFFF" />
          <SolidColorBrush x:Key="MutedTileMutedBrush"     Color="#FBE6E6" />
          <SolidColorBrush x:Key="TileBorderBrush"         Color="#C0C5CA" />
          <SolidColorBrush x:Key="TileBorderMutedBrush"    Color="#C84040" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>