<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both TFMs: the plain one for Linux, the Windows one for NAudio/WASAPI audio. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041</TargetFrameworks>
    <!-- Lets the Windows TFM compile on Linux/macOS (compile-only; never run here). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CaptureSpike.App</RootNamespace>
    <!-- .axaml files are compiled by Avalonia -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- App icon: .ico for the Windows exe, .png for the Avalonia window.
         Files are optional: if Assets/capturespike-icon.* is missing (e.g.,
         binaries not yet synced), the build falls back to the default icon. -->
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\capturespike-icon.png" Condition="Exists('Assets\capturespike-icon.png')" />
  </ItemGroup>

  <!-- MarkView.Avalonia styles are pulled in via a StyleInclude in App.axaml. -->

  <!-- Decode the base64-encoded icon (checked in as text since the push tool
       is text-only). Runs once; the PNG is gitignored after decoding. -->
  <Target Name="DecodeAppIcon" BeforeTargets="PrepareForBuild"
          Condition="!Exists('Assets/capturespike-icon.png') And Exists('Assets/capturespike-icon.png.b64')">
    <Exec Command="powershell -NoProfile -Command &quot;[IO.File]::WriteAllBytes('Assets/capturespike-icon.png', [Convert]::FromBase64String([IO.File]::ReadAllText('Assets/capturespike-icon.png.b64')))&quot;"
          Condition="'$(OS)' == 'Windows_NT'" WorkingDirectory="$(ProjectDir)" />
    <Exec Command="python3 -c &quot;import base64; open('Assets/capturespike-icon.png','wb').write(base64.b64decode(open('Assets/capturespike-icon.png.b64').read()))&quot;"
          Condition="'$(OS)' != 'Windows_NT'" WorkingDirectory="$(ProjectDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- MarkView.Avalonia: Markdig-powered markdown viewer for the
         Script & Notes split-view preview pane. -->
    <PackageReference Include="MarkView.Avalonia" Version="12.2.1" />
    <ProjectReference Include="..\CaptureSpike.Core\CaptureSpike.Core.csproj" />
  </ItemGroup>

  <!-- Bundled external tools (ffmpeg, mpv): fetched by scripts/fetch-tools.*
       into tools/<rid>/. They ship next to the app so ToolPaths finds them
       without any user install. The TFM determines the OS in this project
       (windows TFM -> win-x64 tools, plain TFM -> linux-x64 tools). -->
  <ItemGroup>
    <Content Include="..\..\tools\win-x64\**"
             Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041'"
             Link="tools\win-x64\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="..\..\tools\linux-x64\**"
             Condition="'$(TargetFramework)' == 'net10.0'"
             Link="tools\linux-x64\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="..\..\tools\THIRD-PARTY-LICENSES.md"
             Link="tools\THIRD-PARTY-LICENSES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

</Project>
