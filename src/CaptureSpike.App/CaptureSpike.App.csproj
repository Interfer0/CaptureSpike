<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both TFMs: the plain one for Linux, the Windows one for NAudio/WASAPI audio. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041</TargetFrameworks>
    <!-- Lets the Windows TFM compile on Linux/macOS (compile-only; never run here). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CaptureSpike.App</RootNamespace>
    <!-- .axaml files are compiled by Avalonia -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="..\CaptureSpike.Core\CaptureSpike.Core.csproj" />
  </ItemGroup>

  <!-- Bundled external tools (ffmpeg, mpv): fetched by scripts/fetch-tools.*
       into tools/<rid>/. They ship next to the app so ToolPaths finds them
       without any user install. Only the current RID's folder is published. -->
  <ItemGroup>
    <Content Include="..\..\tools\$(RuntimeIdentifier)\**"
             Link="tools\$(RuntimeIdentifier)\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="..\..\tools\THIRD-PARTY-LICENSES.md"
             Link="tools\THIRD-PARTY-LICENSES.md"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

</Project>
