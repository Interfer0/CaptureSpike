<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CaptureSpike.App"
        x:Class="CaptureSpike.App.MainWindow"
        Title="CaptureSpike" Width="1180" Height="720" MinWidth="760" MinHeight="600">
  <Window.Styles>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Monospace" />
      <Setter Property="Foreground" Value="{DynamicResource BadgeForegroundBrush}" />
    </Style>
    <Style Selector="Border.badge > TextBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Monospace" />
      <Setter Property="Foreground" Value="{DynamicResource BadgeForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="26" />
    </Style>
    <Style Selector="Button.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center" Margin="0,0,8,0">
        <TextBlock Text="{Binding ProjectFolderText}"
                   VerticalAlignment="Center" FontSize="15" Opacity="0.6" />
        <Button Content="Projects" Command="{Binding ProjectsCommand}"
                FontSize="15" Padding="8,2" />
      </StackPanel>
      <Menu>
        <MenuItem Header="_File">
          <MenuItem Header="_Projects..." Command="{Binding ProjectsCommand}" />
          <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" />
          <MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" />
          <MenuItem Header="_Rename Project..." Command="{Binding RenameProjectCommand}" />
          <Separator />
          <MenuItem Header="_Settings..." Command="{Binding SettingsCommand}" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="Sources Panel" ToggleType="CheckBox"
                    IsChecked="{Binding IsSourcesVisible, Mode=TwoWay}" />
          <MenuItem Header="Log Output" ToggleType="CheckBox"
                    IsChecked="{Binding IsLogVisible, Mode=TwoWay}" />
        </MenuItem>
      </Menu>
    </DockPanel>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="8,4">
      <TextBlock Text="{Binding Status}" FontSize="15" Opacity="0.8" />
    </Border>

    <!-- Log output: drag the splitter above it to show more lines.
         The panel height is bound to LogPanelHeight so the
         GridSplitter can actually drive the resize. MinHeight
         keeps the button row usable even when the user drags
         the splitter all the way up. -->
    <DockPanel DockPanel.Dock="Bottom"
                IsVisible="{Binding IsLogVisible}"
                Height="{Binding LogPanelHeight, Mode=TwoWay}"
                MinHeight="80">
      <DockPanel DockPanel.Dock="Top" Margin="8,4,8,2">
        <Button DockPanel.Dock="Right" Classes="plain" Content="Clear"
                Command="{Binding ClearLogCommand}" FontSize="13"
                ToolTip.Tip="Clear the log" />
        <Button DockPanel.Dock="Right" Classes="plain" Content="Copy"
                Command="{Binding CopyLogCommand}" FontSize="13"
                Margin="0,0,6,0"
                ToolTip.Tip="Copy the log to the clipboard so you can paste it elsewhere" />
        <Button DockPanel.Dock="Right" Classes="plain" Content="Open Log…"
                Command="{Binding OpenLogFolderCommand}" FontSize="13"
                Margin="0,0,12,0"
                ToolTip.Tip="Open the folder where session logs and crash.log are written on disk" />
        <TextBlock Text="Log" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox x:Name="LogListBox" ItemsSource="{Binding LogLines}" Margin="8,0,8,6"
               FontFamily="Monospace" FontSize="12" />
    </DockPanel>
    <GridSplitter DockPanel.Dock="Bottom" Height="5" HorizontalAlignment="Stretch"
                  ResizeDirection="Rows" IsVisible="{Binding IsLogVisible}" />

    <Grid Margin="8" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="0" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- The three main panels (left=palette, middle=take
           workspace, right=notes) are user-resizable. Two
           GridSplitters between them let the user drag to
           grow/shrink. The widths are bound two-way to
           MainViewModel.LeftColumnWidth / RightColumnWidth
           so the resize sticks across the session. The
           middle column uses * so it auto-fills whatever
           space is left. -->
      <Grid Grid.Column="0" Width="{Binding LeftColumnWidth, Mode=TwoWay}"
            MinWidth="160" Margin="0,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" />
          <RowDefinition Height="{Binding SourcesSplitterHeight}" />
          <RowDefinition Height="{Binding SourcesRowHeight}" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <TextBlock DockPanel.Dock="Top" Text="Scenes" FontWeight="Bold" Margin="0,0,0,4" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
            <Button Content="Add" Command="{Binding AddSceneCommand}" />
            <Button Content="↑" Command="{Binding MoveSceneUpCommand}" />
            <Button Content="↓" Command="{Binding MoveSceneDownCommand}" />
            <Button Content="Delete" Command="{Binding DeleteSceneCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="badge">
                    <TextBlock Text="{Binding TakeCount}" />
                  </Border>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="2" IsVisible="{Binding IsSourcesVisible}">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddPaletteSourceCommand}"
                    ToolTip.Tip="Add a new kind of source to the global palette (e.g. a second webcam)" />
            <TextBlock Text="Available sources" FontWeight="Bold" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox ItemsSource="{Binding PaletteSources}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!--
                  source-missing class on the outer Border lights the row
                  red when the saved device wasn't seen in the latest
                  detection sweep. Tooltip explains why.
                -->
                <Border Classes.source-missing="{Binding IsDeviceMissing}"
                        Padding="2">
                  <StackPanel Spacing="2">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="plain" Content="×"
                              Command="{Binding DeleteCommand}"
                              ToolTip.Tip="Delete from palette" />
                      <Border Classes="badge">
                        <TextBox Text="{Binding Badge, Mode=TwoWay}" MaxLength="3"
                                 ToolTip.Tip="Rename the source badge (e.g. M1, MK)" />
                      </Border>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </DockPanel>
                    <DockPanel Margin="22,0,0,0">
                      <Button DockPanel.Dock="Right" Classes="plain"
                              Content="{Binding RefreshGlyph}"
                              Command="{Binding RefreshDevicesCommand}"
                              ToolTip.Tip="Detect devices" />
                      <ComboBox ItemsSource="{Binding Devices}"
                                SelectedItem="{Binding SelectedDevice}"
                                IsEnabled="{Binding DetectionCompleted}"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="Which device to capture">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <!-- Take workspace: transport lives in the tiled playback window.
                 Per-track mute/include rows + take list stay here. -->
      <GridSplitter Grid.Column="1" Width="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
      <Grid Grid.Column="2" MinWidth="0" ClipToBounds="True" Margin="0,0,8,0"
            RowDefinitions="Auto,Auto,Auto,Auto,2*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
          <TextBlock Text="{Binding TakeHeaderText}" FontWeight="Bold" FontSize="17" />
          <TextBlock Text="{Binding TakeSceneHeader}" Opacity="0.6"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding NowPlayingText}" FontWeight="SemiBold"
                     VerticalAlignment="Center" IsVisible="{Binding HasPlayerTake}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasPlayerTake}">
          <ItemsControl ItemsSource="{Binding PlayerTracks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Classes="badge">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="15" />
                  <Button Classes="plain" Content="{Binding IncludeIcon}"
                          Command="{Binding ToggleIncludeCommand}"
                          ToolTip.Tip="{Binding IncludeTip}" FontSize="17" />
                  <Button Classes="plain" Content="{Binding MuteIcon}"
                          Command="{Binding ToggleMuteCommand}"
                          ToolTip.Tip="{Binding MuteTip}" FontSize="17" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding PlayerCaptionText}"
                   FontSize="14" Opacity="0.5" Margin="0,2,0,0"
                   IsVisible="{Binding HasPlayerTake}" />

        <DockPanel Grid.Row="3" Margin="0,8,0,4">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Takes" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Classes="badge" VerticalAlignment="Center">
              <TextBlock Text="{Binding Takes.Count}" />
            </Border>
          </StackPanel>
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding TakeFilterChips}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="plain" Command="{Binding ToggleCommand}"
                        ToolTip.Tip="Show only takes recorded with this source">
                  <Border Classes="badge" Opacity="{Binding ChipOpacity}">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <ListBox Grid.Row="4" ItemsSource="{Binding Takes}"
                 SelectedItem="{Binding SelectedTake}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                <DockPanel>
                  <Button DockPanel.Dock="Left" Classes="plain" Content="▶"
                          Command="{Binding PlayTakeCommand}" FontSize="15"
                          ToolTip.Tip="Play all sources tiled in one window, in sync" />
                  <Button DockPanel.Dock="Left" Classes="plain" Content="⇆"
                          Command="{Binding NormalizeCommand}" FontSize="15"
                          ToolTip.Tip="Normalize: write aligned copies of all source files and reset their offsets. Originals are kept." />
                  <Button DockPanel.Dock="Left" Classes="plain" Content="↶"
                          Command="{Binding UnnormalizeCommand}" FontSize="15"
                          ToolTip.Tip="Unnormalize: revert a normalized take back to its original files. Deletes the .normalized.* files and points the take at the originals." />
                  <Button DockPanel.Dock="Left" Classes="plain" Content="{Binding ExpandGlyph}"
                          Command="{Binding ToggleExpandedCommand}" FontSize="13"
                          ToolTip.Tip="Show take files" />
                  <Button DockPanel.Dock="Left" Classes="plain" Content="{Binding StarText}"
                          Command="{Binding ToggleFavoriteCommand}" FontSize="16"
                          ToolTip.Tip="Mark as favorite" />
                  <Button DockPanel.Dock="Right" Classes="plain" Content="🗑"
                          Command="{Binding DeleteCommand}" ToolTip.Tip="Delete take" />
                  <Button DockPanel.Dock="Right" Classes="plain" Content="📁"
                          Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open take folder" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Opacity="0.6"
                             VerticalAlignment="Center" Margin="8,0" FontSize="15" />
                  <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                             VerticalAlignment="Center" Margin="4,0,8,0" />
                  <ItemsControl ItemsSource="{Binding Badges}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="badge">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
                </ScrollViewer>
                <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding IsExpanded}"
                              Margin="30,2,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,2">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Opacity="0.6"
                                     FontSize="14" FontFamily="Monospace"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding DisplayName}" FontSize="14" Opacity="0.85"
                                     FontFamily="Monospace" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Offset adjustment (only for matched source files) -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                                    IsVisible="{Binding HasOffset}">
                          <TextBlock Text="{Binding OffsetSummaryText}" FontSize="12" Opacity="0.7"
                                     VerticalAlignment="Center" FontFamily="Monospace" />
                          <TextBlock Text="offset ms:" FontSize="12" Opacity="0.7"
                                     VerticalAlignment="Center" />
                          <TextBox Text="{Binding EditableOffsetText, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                   Width="80" VerticalAlignment="Center"
                                   ToolTip.Tip="Type an offset in milliseconds" />
                          <Button Content="Reset" Command="{Binding ResetOffsetCommand}"
                                  FontSize="12" Padding="8,2" VerticalAlignment="Center"
                                  ToolTip.Tip="Clear manual offset, use recorded value" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Scene setup + record + Script & notes split-view -->
      <GridSplitter Grid.Column="3" Width="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
      <Grid Grid.Column="4" Width="{Binding RightColumnWidth, Mode=TwoWay}"
            MinWidth="240" RowDefinitions="Auto,Auto,*,5,*,5,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    Margin="0,0,0,4">
          <TextBlock Text="{Binding SelectedScene.Title}" FontWeight="Bold" FontSize="17" />
          <TextBlock Text="{Binding SceneNumberText}" Opacity="0.6"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
          <TextBlock Text="Title" FontSize="15" Opacity="0.7" />
          <TextBox Text="{Binding SelectedScene.Title, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="2" MinHeight="80" RowDefinitions="Auto,Auto,*,Auto">
          <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
            <TextBlock Text="Sources in scene"
                       FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Classes="plain" Content="ℹ"
                    FontSize="14" Padding="4,0"
                    VerticalAlignment="Center" Margin="4,0,0,0"
                    ToolTip.Tip="Click a source to turn it off for the next take. × takes it out of this scene." />
          </DockPanel>
          <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddSceneSourceCommand}" />
            <ComboBox ItemsSource="{Binding AvailablePaletteSources}"
                      SelectedItem="{Binding SelectedPaletteSourceToAdd}"
                      HorizontalAlignment="Stretch" Margin="0,0,4,0"
                      PlaceholderText="Add a source…">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="badge">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <ListBox Grid.Row="2" ItemsSource="{Binding SceneSources}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="plain" Content="×"
                          Command="{Binding RemoveCommand}"
                          ToolTip.Tip="Take out of this scene" />
                  <Button Command="{Binding ToggleCommand}" Classes="plain"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          ToolTip.Tip="Click to turn off for the next take">
                    <StackPanel Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Dot}" VerticalAlignment="Center" />
                        <Border Classes="badge">
                          <TextBlock Text="{Binding Badge}" />
                        </Border>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding DeviceLabel}" FontSize="14" Opacity="0.6"
                                 Margin="22,0,0,0" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <ScrollViewer Grid.Row="4" MinHeight="70"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4" Margin="0,4">
            <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordCommand}"
                    FontSize="19" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="8"
                    ToolTip.Tip="The window minimizes when you start recording. Stop from the tray icon." />
            <TextBlock Text="{Binding RecordingElapsed}" FontFamily="Monospace" FontSize="17"
                       HorizontalAlignment="Center" IsVisible="{Binding IsRecording}" />
            <TextBlock Text="{Binding NextTakeText}" FontSize="15"
                       Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,4" />
          </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <!-- Script & notes: plain text editor. Scene.Notes is plain text;
             the user can paste markdown or any other text. There's no
             formatting toolbar and no markdown renderer here — the
             notes editor is a TextBox bound directly to the scene.
             The MarkdownParser/Serializer in CaptureSpike.Core remains
             available for any future markdown bridge (e.g., exporting
             scripts in a known format). -->
        <Grid Grid.Row="6" MinHeight="80" RowDefinitions="Auto,*" Margin="0,4,0,0">
          <DockPanel Grid.Row="0">
            <TextBlock Text="Notes" FontSize="15" Opacity="0.7" />
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding SelectedScene.WordCountText}"
                       FontSize="14" Opacity="0.6" />
          </DockPanel>
          <TextBox Grid.Row="1" Margin="0,4,0,0" MinHeight="40"
                   Text="{Binding SelectedScene.Notes, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   FontFamily="Consolas, Menlo, monospace"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>

      </Grid>
    </Grid>
  </DockPanel>
</Window>