<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CaptureSpike.App"
        x:Class="CaptureSpike.App.MainWindow"
        Title="CaptureSpike" Width="1180" Height="720" MinWidth="960" MinHeight="600">
  <Window.Styles>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Background" Value="#3d3d3d" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Monospace" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <TextBlock DockPanel.Dock="Right" Text="{Binding ProjectFolderText}"
                 VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Opacity="0.6" />
      <Menu>
        <MenuItem Header="_File">
          <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" />
          <MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" />
        </MenuItem>
      </Menu>
    </DockPanel>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="Gray" Padding="8,4">
      <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.8" />
    </Border>

    <Grid ColumnDefinitions="260,*,340" Margin="8">
      <!-- Scenes + source palette -->
      <Grid Grid.Column="0" Margin="0,0,8,0" RowDefinitions="2*,8,1*">
        <DockPanel Grid.Row="0">
          <TextBlock DockPanel.Dock="Top" Text="Scenes" FontWeight="Bold" Margin="0,0,0,4" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
            <Button Content="Add" Command="{Binding AddSceneCommand}" />
            <Button Content="↑" Command="{Binding MoveSceneUpCommand}" />
            <Button Content="↓" Command="{Binding MoveSceneDownCommand}" />
            <Button Content="Delete" Command="{Binding DeleteSceneCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="badge">
                    <TextBlock Text="{Binding TakeCount}" />
                  </Border>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="2">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddPaletteSourceCommand}"
                    ToolTip.Tip="Add a source to the palette" />
            <TextBlock Text="Sources" FontWeight="Bold" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox ItemsSource="{Binding PaletteSources}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="plain" Content="×"
                            Command="{Binding DeleteCommand}"
                            ToolTip.Tip="Delete from palette" />
                    <Border Classes="badge">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="6,0,0,0" />
                  </DockPanel>
                  <DockPanel Margin="22,0,0,0">
                    <Button DockPanel.Dock="Right" Classes="plain"
                            Content="{Binding RefreshGlyph}"
                            Command="{Binding RefreshDevicesCommand}"
                            ToolTip.Tip="Detect devices" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="Which device to capture">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </DockPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <!-- Take workspace: preview + takes -->
      <Grid Grid.Column="1" Margin="0,0,8,0"
            RowDefinitions="Auto,3*,Auto,Auto,Auto,Auto,2*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
          <TextBlock Text="{Binding TakeHeaderText}" FontWeight="Bold" FontSize="14" />
          <TextBlock Text="{Binding TakeSceneHeader}" Opacity="0.6"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" CornerRadius="4"
                ClipToBounds="True" Background="Black">
          <Panel>
            <app:MpvVideoHost x:Name="VideoHost" />
            <TextBlock Text="{Binding PlayerPlaceholderText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                       IsVisible="{Binding !HasPlayerTake}" />
          </Panel>
        </Border>

        <DockPanel Grid.Row="2" IsEnabled="{Binding HasPlayerTake}" Margin="0,8,0,0">
          <Button DockPanel.Dock="Left" Content="{Binding PlayerPlayPauseText}"
                  Command="{Binding PlayerPlayPauseCommand}" Margin="0,0,8,0" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding PlayerTimeText}"
                     VerticalAlignment="Center" FontFamily="Monospace" Margin="8,0,0,0" />
          <Slider Minimum="0" Maximum="{Binding PlayerDurationSeconds}"
                  Value="{Binding PlayerPositionSeconds, Mode=OneWay}"
                  VerticalAlignment="Center"
                  PointerPressed="OnSeekPointerPressed"
                  PointerReleased="OnSeekPointerReleased" />
        </DockPanel>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding PlayerTracks}"
                      IsVisible="{Binding HasPlayerTake}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Classes="badge">
                  <TextBlock Text="{Binding Badge}" />
                </Border>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" />
                <Button Classes="plain" Content="{Binding MuteIcon}"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip.Tip="{Binding MuteTip}" FontSize="14" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="4" Text="Tracks play in sync using the start offsets in take.json."
                   FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                   IsVisible="{Binding HasPlayerTake}" />

        <DockPanel Grid.Row="5" Margin="0,8,0,4">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Takes" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Classes="badge" VerticalAlignment="Center">
              <TextBlock Text="{Binding Takes.Count}" />
            </Border>
          </StackPanel>
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding TakeFilterChips}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="plain" Command="{Binding ToggleCommand}"
                        ToolTip.Tip="Show only takes recorded with this source">
                  <Border Classes="badge" Opacity="{Binding ChipOpacity}">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <ListBox Grid.Row="6" ItemsSource="{Binding Takes}"
                 SelectedItem="{Binding SelectedTake}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Left" Classes="plain" Content="{Binding StarText}"
                        Command="{Binding ToggleFavoriteCommand}" FontSize="13"
                        ToolTip.Tip="Mark as favorite" />
                <Button DockPanel.Dock="Right" Classes="plain" Content="🗑"
                        Command="{Binding DeleteCommand}" ToolTip.Tip="Delete take" />
                <Button DockPanel.Dock="Right" Classes="plain" Content="📁"
                        Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open take folder" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Opacity="0.6"
                           VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,8,0" />
                <ItemsControl ItemsSource="{Binding Badges}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="badge">
                        <TextBlock Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Scene setup + record -->
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                    Margin="0,0,0,4">
          <TextBlock Text="{Binding SelectedScene.Title}" FontWeight="Bold" FontSize="14" />
          <TextBlock Text="{Binding SceneNumberText}" Opacity="0.6"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
          <TextBlock Text="Title" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding SelectedScene.Title, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Sources in this scene"
                   FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddSceneSourceCommand}" />
          <ComboBox ItemsSource="{Binding AvailablePaletteSources}"
                    SelectedItem="{Binding SelectedPaletteSourceToAdd}"
                    HorizontalAlignment="Stretch" Margin="0,0,4,0"
                    PlaceholderText="Add a source…">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="badge">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding SceneSources}" MaxHeight="140">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="plain" Content="×"
                        Command="{Binding RemoveCommand}"
                        ToolTip.Tip="Take out of this scene" />
                <Button Command="{Binding ToggleCommand}" Classes="plain"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        ToolTip.Tip="Click to turn off for the next take">
                  <StackPanel Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Dot}" VerticalAlignment="Center" />
                      <Border Classes="badge">
                        <TextBlock Text="{Binding Badge}" />
                      </Border>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceLabel}" FontSize="11" Opacity="0.6"
                               Margin="22,0,0,0" />
                  </StackPanel>
                </Button>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock DockPanel.Dock="Top" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Text="Click a source to turn it off for the next take. × takes it out of this scene." />

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
          <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordCommand}"
                  FontSize="16" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Padding="8" />
          <TextBlock Text="{Binding RecordingElapsed}" FontFamily="Monospace" FontSize="14"
                     HorizontalAlignment="Center" IsVisible="{Binding IsRecording}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding NextTakeText}" FontSize="12"
                   Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"
                   Text="The window minimizes during the countdown. Stop with F9." />

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
          <TextBlock Text="Script and notes" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding SelectedScene.Notes, Mode=TwoWay}"
                   AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedScene.WordCountText}" FontSize="11" Opacity="0.6" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Export film…"
                Command="{Binding ExportCommand}" Margin="0,8,0,0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
