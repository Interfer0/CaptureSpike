<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CaptureSpike.App.ProjectBrowserWindow"
        Title="Projects" Width="520" Height="440"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" x:Name="LibraryLabel" FontSize="14" Opacity="0.6"
               TextWrapping="Wrap" Margin="0,0,0,4" />
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
      <TextBlock Text="New project" FontWeight="Bold" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Create" Click="OnCreate" Margin="8,0,0,0" />
        <TextBox x:Name="NameBox" PlaceholderText="Project name" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Click="OnCancel" />
        <Button Content="Delete" Click="OnDelete" />
        <Button Content="Rename" Click="OnRename" />
        <Button Content="Open" Click="OnOpen" />
      </StackPanel>
    </StackPanel>
    <ListBox x:Name="ProjectList" Margin="0,8">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Spacing="1" Margin="4">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
            <TextBlock Text="{Binding Info}" FontSize="14" Opacity="0.6" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
